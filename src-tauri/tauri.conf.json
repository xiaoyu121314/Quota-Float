{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Float",
  "version": "0.2.21",
  "identifier": "app.quotafloat.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1421", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "macOSPrivateApi": true, "windows": [
    { "label": "widget", "title": "Quota Float", "width": 80, "height": 80, "minWidth": 80, "minHeight": 80, "maxWidth": 314, "maxHeight": 314, "resizable": false, "decorations": false, "transparent": true, "backgroundColor": "#00000000", "alwaysOnTop": true, "skipTaskbar": true, "shadow": false, "visible": true },
    { "label": "context-menu", "title": "Quota Float - Menu", "url": "index.html?contextMenu", "width": 760, "height": 560, "resizable": false, "decorations": false, "transparent": true, "backgroundColor": "#00000000", "alwaysOnTop": true, "skipTaskbar": true, "shadow": false, "visible": false },
    { "label": "settings", "title": "Quota Float - Settings", "url": "index.html?settings", "width": 440, "height": 440, "minWidth": 400, "minHeight": 400, "resizable": false, "decorations": true, "transparent": false, "backgroundColor": "#241923", "alwaysOnTop": false, "skipTaskbar": false, "visible": false }
  ], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:" } },
  "bundle": { "active": true, "createUpdaterArtifacts": false, "targets": "all", "category": "Utility", "shortDescription": "Codex quota at a glance", "longDescription": "A lightweight floating desktop card for Codex usage limits.", "copyright": "Copyright Quota Float contributors", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
